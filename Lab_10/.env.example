# Copy to .env and fill in. .env is ignored by Git; never commit real values.
# Database: SQLAlchemy URL (SQLite file by default; in Docker the volume is /data)
DATABASE_URL=sqlite:///data/students.db
# development | test | production (production refuses to start without API_TOKEN)
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Bind address of the API server
API_HOST=127.0.0.1
API_PORT=8000
# Secret. When set, POST/PATCH/DELETE require the header  X-API-Token: <value>
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
